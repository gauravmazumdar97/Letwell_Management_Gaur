# SQLite database file (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Auth.js secret - generate a long random string for local use
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-local-secret"

# Optional: only set if Auth.js cannot infer the host (defaults work for local `npm run dev`)
# AUTH_URL="http://localhost:3000"
